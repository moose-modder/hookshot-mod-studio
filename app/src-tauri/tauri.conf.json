{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hookshot Mod Studio",
  "version": "0.1.2",
  "identifier": "io.hookshot.modstudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost blob: data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Model mods for Hookshot",
    "longDescription": "Pick a model from your Hookshot install, edit it in Blender, and build and install the mod.",
    "license": "GPL-3.0-or-later"
  }
}
